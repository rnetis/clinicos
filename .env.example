# Copy to .env (or export) before running the server. Never commit real values.

# SQLite database file. The directory must exist and be writable.
DATABASE_URL=sqlite:///var/lib/clinicos/clinicos.db

# Address to listen on. Bind to 127.0.0.1 behind a reverse proxy.
CLINICOS_BIND=127.0.0.1:8080

# Static frontend directory (the bundled `web` folder).
CLINICOS_STATIC_DIR=web

# Seed the demo clinic and demo accounts (never enable in production).
CLINICOS_DEMO=0
CLINICOS_DEMO_PASSWORD=DemoClinic!2026

# Initial administrator, created only when the users table is empty.
CLINICOS_ADMIN_USERNAME=admin
CLINICOS_ADMIN_PASSWORD=change-me-to-a-long-password

# Clinic identity defaults.
CLINICOS_NAME_FA=درمانگاه تخصصی ایران زمین
CLINICOS_NAME_EN=Iran Zamin Specialty Clinic

# Timezone used for "today", booking and reports.
CLINICOS_TZ=Asia/Tehran

# Session lifetime (1–720 hours) and request body limit.
CLINICOS_SESSION_TTL_HOURS=12
CLINICOS_MAX_BODY_BYTES=1048576

# Set to 1 when served over HTTPS so cookies carry the Secure flag.
CLINICOS_COOKIE_SECURE=0

# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For.
CLINICOS_TRUST_PROXY=0

# Structured JSON logs for log collectors.
CLINICOS_LOG_JSON=0
